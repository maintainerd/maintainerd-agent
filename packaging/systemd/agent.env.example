# maintainerd-agent — /etc/maintainerd/agent.env
#
# Install as root:root, mode 0600. systemd reads it as PID 1 before dropping to
# the `maintainerd` user, so the service's own uid never needs read access to
# the secrets below.
#
# SECRETS GO HERE AND NOWHERE ELSE. A value passed on a command line is readable
# by every user on the host through /proc/<pid>/cmdline (`ps`), so an
# EnvironmentFile is the only supported way to hand this process a credential.
# Lines marked SECRET must never be echoed, logged, or copied into a ticket.
#
# One value per line, KEY=value, no shell quoting or expansion — systemd is not
# a shell here.

# --- identity ---------------------------------------------------------------

# REQUIRED. Free-form; what this host is called in logs.
AGENT_NAME=agent-01

# REQUIRED whenever CORE_ADDR is set: this host's agent_uuid in Core, as printed
# by CreateAgent. Every gateway RPC carries it, and the enrollment CSR is issued
# for it (SAN spiffe://maintainerd/agent/<uuid>).
AGENT_UUID=

# SECRET. SINGLE-USE, ONE BOOT ONLY.
#
# Core's CreateAgent returns this token once. On the first start the agent
# generates a key + CSR locally and exchanges the token for an mTLS client
# certificate, which it writes under the state directory. From then on the
# certificate is the identity and this variable is ignored.
#
# DELETE THE LINE after the first successful boot (journalctl will show
# "agent enrolled with core"). Core will not honour it twice, so a token left
# in place is a leaked credential with no remaining use.
AGENT_JOIN_TOKEN=

# --- control plane ----------------------------------------------------------

# REQUIRED. The maintainerd-core gRPC address the agent dials OUT to. The agent
# ALWAYS dials Core; Core never dials a host.
#
# With APP_ENV unset or anything other than "development", an empty or missing
# CORE_ADDR is a BOOT FAILURE by design — an agent with no control plane starts,
# reports healthy and converges nothing, which is a broken host that never
# alerts.
CORE_ADDR=core.internal:9090

# Anything other than the exact string "development" gets production
# (fail-closed) semantics, including empty and including a typo. Leave it unset
# on a real host, or set it explicitly for documentation value.
APP_ENV=production

# debug|info|warn|error. Default info.
LOG_LEVEL=info

# TLS for the outbound Core channel. Required outside development: with no TLS
# material configured at all the agent refuses to dial. Set the CA when Core's
# certificate is issued by a private CA; set the server name only when it
# differs from the dial host.
CORE_TLS_CA_FILE=/etc/maintainerd/core-ca.crt
#CORE_TLS_SERVER_NAME=

# --- the agent's own identity token (outbound) -------------------------------
#
# The mTLS certificate above authenticates the CHANNEL. These authenticate the
# PRINCIPAL: the agent's OAuth2 client in maintainerd-auth, whose token rides on
# every RPC. Outside development, a CORE_ADDR with none of this configured is a
# boot failure — an anonymous agent channel would let a host act without an
# identity.

AUTH_TOKEN_URL=https://auth.internal/oauth2/token
AGENT_CLIENT_ID=

# PREFERRED. Private-key JWT: the key never leaves this host, so a dump of
# Auth's database cannot impersonate this agent. The FILE is referenced here;
# the key itself belongs in the state directory, mode 0600, owned by
# maintainerd:maintainerd.
AGENT_CLIENT_PRIVATE_KEY_FILE=/var/lib/maintainerd-agent/identity/client.key

# SECRET. Fallback for deployments that cannot manage a key file. Set this OR
# the key file above, never both.
#AGENT_CLIENT_SECRET=

# --- inbound verification (the agent's own gRPC surface) ---------------------
#
# All three or none. Outside development, an incomplete set means the guarded
# AgentService does not come up at all — the listener serves health only. A JWKS
# URL without an issuer and audience check would accept any token Auth ever
# signed, so a partial set is treated as no set.

AUTH_JWKS_URL=https://auth.internal/.well-known/jwks.json
AUTH_ISSUER=https://auth.internal/
AUTH_AUDIENCE=maintainerd-agent

# --- listeners ---------------------------------------------------------------

# The guarded AgentService (Ping/Info). Bind it to a management interface, not
# 0.0.0.0, unless something in front of it is doing that job.
GRPC_PORT=9091
# HTTP /healthz + /readyz. These two routes are UNAUTHENTICATED by design — the
# only exception in the whole surface — because a probe cannot hold a token.
HTTP_PORT=8091

# --- loops -------------------------------------------------------------------

# Work-pull cadence, and the offline supervision cadence.
POLL_INTERVAL=5s
# Heartbeat cadence. Runs on its own goroutine, so a long image pull can never
# make Core think the host is down.
HEARTBEAT_INTERVAL=10s
# How often owned workloads are re-observed and state transitions reported.
DRIFT_INTERVAL=30s
# How many work items converge at once.
RECONCILE_CONCURRENCY=4
# Consecutive pull failures before the agent supervises the cached system tier
# offline (auth, secret, core itself must not die because their scheduler is
# away).
OFFLINE_THRESHOLD=3

# --- state -------------------------------------------------------------------

# Must match the unit's StateDirectory=. Holds the enrolled client key + cert
# and the system-tier work cache; 0700/0600 because work specs can embed
# configuration secrets. Do not point this at /tmp — the unit runs with
# PrivateTmp=yes and the cache would not survive a restart.
STATE_DIR=/var/lib/maintainerd-agent

# Where the agent reads its OWN secret-valued configuration from. "env" (the
# default) means this file.
SECRET_PROVIDER=env

# --- registry credentials ----------------------------------------------------
#
# SECRET, one per registry reference. base64(username:password) for a spec's
# registry_credential_ref: a spec naming "ghcr" resolves
# AGENT_REGISTRY_AUTH_GHCR here. Credentials are resolved on the host and never
# travel inside a work spec.
#AGENT_REGISTRY_AUTH_GHCR=
